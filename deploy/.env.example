# Copy to .env next to compose.yaml and fill in.

# Public HTTPS address of your server
PUBLIC_URL=https://poker.example.com

# First admin (created once, ignored after an admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional. Leave empty and the server generates its secret once and keeps it
# in ./data/server.key. Set it (64 hex chars, e.g. `openssl rand -hex 32`) only
# if you want the secret outside the data folder.
SERVER_SECRET=

# Image version: a release like 0.1.0, or latest
OXIPOKER_VERSION=latest

# ---- Full option only (voice and video) ----
# LIVEKIT_URL is the public wss:// address your proxy forwards to port 7880.
# Generate a key and secret with:
#   docker run --rm livekit/livekit-server generate-keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TURN_ENABLED=false
LIVEKIT_TURN_DOMAIN=
