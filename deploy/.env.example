# Copy to .env next to compose.yaml and fill in.

# Public HTTPS address of your server
PUBLIC_URL=https://poker.example.com

# First admin (created once, ignored after an admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional. Leave empty and the server generates its secret once and keeps it
# in ./data/server.key. Set it (64 hex chars, e.g. `openssl rand -hex 32`) only
# if you want the secret outside the data folder.
SERVER_SECRET=

# Optional. Own Android builds allowed to use passkeys here, as
# package=SHA256 of the signing certificate (comma-separated). The official
# app works without this.
ANDROID_APPS=

# Image version: a release like 1.0.0, or latest
OXIPOKER_VERSION=latest
# Registry: Docker Hub by default. Every release is also on
# ghcr.io/oxisoft/oxipoker (same tags), if Docker Hub limits your pulls.
OXIPOKER_IMAGE=oxisoft/oxipoker

# Port on 127.0.0.1 your HTTPS proxy forwards to
OXIPOKER_PORT=8080

# ---- Full option only (voice and video) ----
# LIVEKIT_URL is the public wss:// address your proxy forwards to
# LIVEKIT_HTTP_PORT, e.g. wss://rtc.example.com
# Generate a key and secret with:
#   docker run --rm livekit/livekit-server generate-keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_VERSION=v1.13.11

# Signalling, published on 127.0.0.1 only, for your proxy
LIVEKIT_HTTP_PORT=7880
# Media, open both in your firewall (the first TCP, the second UDP)
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882

# TURN relays media for players whose network blocks UDP. TURN over TLS
# looks like HTTPS traffic and passes strict routers. It needs a domain
# that points at this server and a certificate for it.
LIVEKIT_TURN_ENABLED=false
LIVEKIT_TURN_DOMAIN=
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_TURN_TLS_PORT=5349
# Folder holding the certificate and key for LIVEKIT_TURN_DOMAIN, and the
# file names inside it. The container must be able to read both files.
LIVEKIT_TURN_CERT_DIR=./certs
LIVEKIT_TURN_CERT_FILE=fullchain.pem
LIVEKIT_TURN_KEY_FILE=privkey.pem
